# Stackwise V1 Environment Variables
DATABASE_URL=postgresql://postgres:postgres@db:5432/stackwise
SECRET_KEY=your-super-secret-key-change-me-in-production
# Required by docker-compose.yml (Postgres password for the "db" service).
POSTGRES_PASSWORD=change-me-postgres-password
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["*"]

# --- accounts: sign-in hardening ---------------------------------------------
# Attempts accepted per minute and per client address. Registration bounds how
# many accounts one address can mint; login bounds both a single account (from
# anywhere) and one address (against any account). Process-local: a deployment
# with several workers or a reverse proxy wants the same ceiling at the edge.
# The password policy itself is not configurable — it lives in
# app/core/security.py (10+ characters, letters and digits, ≤72 bytes, not a
# common password).
AUTH_REGISTER_RATE_LIMIT_PER_MINUTE=5
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10

# Async database URL the backend actually connects with. Default is the local
# SQLite file; for Postgres/Supabase use postgresql+asyncpg://… — the asyncpg
# driver is already in requirements.txt. DATABASE_URL above stays the
# docker-compose/Vercel value, and it is also the synchronous spelling Alembic
# migrates through (`postgresql://…`).
#
#   Supabase session pooler (5432) — a server connection per client:
#     SQLALCHEMY_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?ssl=require
#   Supabase transaction pooler (6543) — nothing else to set, see POOL_MODE:
#     SQLALCHEMY_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?ssl=require
#   Direct connection:
#     SQLALCHEMY_URL=postgresql+asyncpg://postgres:<password>@db.<ref>.supabase.co:5432/postgres?ssl=require
SQLALCHEMY_URL=sqlite+aiosqlite:///./stackwise.db
SQLALCHEMY_ECHO=false
# How the engine talks to a hosted pooler: `auto` decides from the port, and
# `direct`/`transaction` force the answer for a pooler that listens elsewhere.
# A transaction pooler gives each transaction a different server connection, so
# prepared statements do not survive it and asyncpg fails with `prepared
# statement "__asyncpg_stmt_1__" does not exist`; `auto` recognises :6543 and
# disables both statement caches for you. Ignored for non-PostgreSQL URLs.
SQLALCHEMY_POOL_MODE=auto

# --- public origins ----------------------------------------------------------
# Both origins must be reachable from the browser; the API one is what the
# provider console must list as the callback prefix.
API_PUBLIC_URL=http://localhost:8001
FRONTEND_URL=http://localhost:3000

# Leave a pair empty to disable that provider: `GET /auth/providers` reports it
# as unavailable and the SPA hides its button.
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: <API_PUBLIC_URL>/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers
#   Authorization callback URL: <API_PUBLIC_URL>/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

OAUTH_STATE_EXPIRE_MINUTES=10

# --- development-only mock provider ------------------------------------------
# Registers `/auth/oauth/mock`: a consent screen served by this API that signs
# in as a fixed `example.com` identity, with no external account and no network
# request. It exists so the whole round-trip (start → consent → callback →
# session in the fragment) can be exercised before any credentials exist — flip
# it on, click the third button on the sign-in form, and turn it off again.
# It stays out of the OpenAPI schema and the API logs a warning while it is on.
# NEVER enable it on a host anyone else can reach.
DEV_OAUTH_MOCK=false

# --- analysis engine: source acquisition -------------------------------------
# GitHub REST base — override for GitHub Enterprise.
GITHUB_API_BASE_URL=https://api.github.com
# Self-hosted GitHub Enterprise on a private network: set this to true to skip
# the private/loopback/metadata-address guard for the host above.
ANALYSIS_ALLOW_PRIVATE_GIT_HOSTS=false

# --- analysis engine: analyzers ----------------------------------------------
# Analyzer binaries are installed platform-wide and pinned in requirements.txt;
# their versions are recorded per run in `analysis_runs.tool_versions`.
ANALYSIS_ENABLED_ANALYZERS=["ruff","bandit","radon"]
# Deliberate ruff rule selection (a project may narrow it to a subset).
ANALYSIS_RUFF_SELECT=E4,E7,E9,F,B
ANALYSIS_RUFF_TIMEOUT_SECONDS=60
ANALYSIS_BANDIT_TIMEOUT_SECONDS=60
ANALYSIS_RADON_TIMEOUT_SECONDS=60
# Upper bound a project-level analyzer timeout is clamped/refused against.
ANALYSIS_MAX_ANALYZER_TIMEOUT_SECONDS=120
# Radon thresholds: complexity at/above 11 (rank C) is a finding; at/above 21 it
# is `high`. Maintainability ranks B and C are reported.
ANALYSIS_COMPLEXITY_FINDING_THRESHOLD=11
ANALYSIS_COMPLEXITY_HIGH_THRESHOLD=21
ANALYSIS_MAINTAINABILITY_MIN_RANK=B

# --- analysis engine: limits (the ceiling a project cannot exceed) ------------
ANALYSIS_MAX_ARCHIVE_SIZE_MB=10
ANALYSIS_MAX_EXTRACTED_SIZE_MB=50
ANALYSIS_MAX_FILE_COUNT=500
ANALYSIS_MAX_FILE_SIZE_KB=1024
ANALYSIS_MAX_WORKSPACE_DEPTH=12
# Uncompressed/compressed ratio above which an archive entry is a bomb.
ANALYSIS_MAX_COMPRESSION_RATIO=200
ANALYSIS_MAX_ANALYSIS_DURATION_SECONDS=300
ANALYSIS_MAX_FINDINGS_PER_RUN=2000
ANALYSIS_MAX_ANALYZER_OUTPUT_BYTES=2000000
ANALYSIS_ANALYZER_MEMORY_MB=1024
ANALYSIS_ANALYZER_CPU_SECONDS=120
# In-process execution slots and the queue between the API and them.
ANALYSIS_MAX_CONCURRENT_RUNS=2
ANALYSIS_QUEUE_WAIT_SECONDS=120
ANALYSIS_MAX_ACTIVE_RUNS_PER_PROJECT=3
ANALYSIS_MAX_ACTIVE_RUNS_PER_USER=5
# Analysis-start requests accepted per user per minute (per worker process).
ANALYSIS_RATE_LIMIT_PER_MINUTE=10
ANALYSIS_MAX_REQUEST_BODY_BYTES=16000000
# Grace period before a `pending`/`running` run is reaped to `failed`.
ANALYSIS_STALE_RUN_GRACE_SECONDS=600

# --- findings agent ----------------------------------------------------------
# The chat that explains analyzer findings (/api/v1/agent). Pick ONE runtime:
#
#   qwen       — a local checkpoint. The model is NOT in requirements.txt:
#                install it with `pip install -r requirements-agent.txt`, then
#                restart the API. Weights come from the Hugging Face hub unless
#                AGENT_MODEL_PATH points at a local copy.
#   cloudflare — a hosted Workers AI model. Nothing to install; set
#                CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN below.
#   none       — the chat is disabled.
#
# With either runtime misconfigured, GET /api/v1/agent/status reports it as
# unavailable and the chat answers 503 with the reason — it never invents an
# explanation.
AGENT_BACKEND=qwen
AGENT_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
# Weights from a local directory instead of the Hugging Face hub (offline hosts):
# AGENT_MODEL_PATH=/models/Qwen2.5-0.5B-Instruct
AGENT_MODEL_PATH=
AGENT_DEVICE=cpu
AGENT_TEMPERATURE=0.2
AGENT_MAX_NEW_TOKENS=512
AGENT_TIMEOUT_SECONDS=120
# Context budget: messages kept, characters per message, findings quoted.
AGENT_MAX_MESSAGES=20
AGENT_MAX_MESSAGE_CHARS=4000
AGENT_MAX_CONTEXT_FINDINGS=60
AGENT_MAX_CONTEXT_CHARS=12000
# Agent requests accepted per user per minute (per worker process).
AGENT_RATE_LIMIT_PER_MINUTE=8

# --- Cloudflare Workers AI (AGENT_BACKEND=cloudflare) ------------------------
# Backend secrets: they are read by the API process only and are never sent to
# the browser. Get both from the Cloudflare dashboard (Workers AI → Use REST
# API); the token needs the `Workers AI - Read` permission. Leave them empty and
# the backend reports itself unavailable instead of failing per request.
#
# CLOUDFLARE_ACCOUNT_ID is the 32-character id in the dashboard URL
# (dash.cloudflare.com/<id>), not the account e-mail and not a full URL: a value
# that is neither is refused at startup (it is interpolated into the request
# path) and named by GET /api/v1/agent/status. Verify the pair with:
#   curl -s localhost:8001/api/v1/agent/status
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Catalogue id, not a Hugging Face one.
CLOUDFLARE_MODEL_ID=@cf/qwen/qwen2.5-coder-32b-instruct
